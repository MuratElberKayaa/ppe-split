# Bu dosyayı ".env" adıyla kopyala; detector.py otomatik okur.
MODEL_PATH=models/best.pt
DASHBOARD_URL=http://localhost:8000

# Dashboard ile AYNI olmalı (kök .env içindeki INGEST_TOKEN). İkisini birlikte değiştirin; yalnızca birini
# değiştirmek olayların 401 ile reddedilip düşürülmesine yol açar.
INGEST_TOKEN=

# ---- KAYNAK YAŞAM DÖNGÜSÜ (FAZ 10-A) ----
# Ağ akışında okuma zaman aşımı (sn): donmuş/kopmuş kamera bu sürede algılanıp yeniden bağlanılır. 0 = OpenCV varsayılanı
# (~30 sn). OPENCV_FFMPEG_CAPTURE_OPTIONS verilirse bu ayar kullanılmaz. Gerçek RTSP kamerayla doğrulanmalı.
# STREAM_READ_TIMEOUT_SEC=10
# Yeniden bağlanma: üstel geri çekilme (+-%20); sağlıklı run (>= RECONNECT_HEALTHY_SEC ve kare) sonrası sıfırlanır.
# RECONNECT_BASE_SEC=2
# RECONNECT_MAX_SEC=60
# RECONNECT_HEALTHY_SEC=30
# Bağlantı yokken dashboard'a 'KAMERA BAGLANTISI YOK' yer tutucu karesi gönderme aralığı (sn)
# OFFLINE_FRAME_SEC=5
# LOOP yalnız DOSYA tekrarını yönetir; canlı kaynak (RTSP/webcam/ağ) koparsa LOOP=0 olsa da yeniden bağlanılır.
# LONG_UNEVALUATED_SEC=10   # bu kadar süredir karar alamayan kişi 'unevaluated_long' olarak işaretlenir

# ---- GÖZLEM / GİZLİLİK (FAZ 9) ----
# Kamera başına sağlık/kapsam dosyası: OUTBOX_DIR/<kamera>.health.json (gizli bilgi/görüntü içermez). docs/PHASE_9_REPORT.md
# HEALTH_EVERY=5          # sağlık dosyası ve kaynak örnekleme aralığı (sn)
# LAG_WARN_SEC=2          # kaynak zaman çizelgesinin bu kadar gerisinde: 'lagging' uyarısı
# FREEZE_WARN_SEC=10      # bu kadar süre birebir aynı kare: 'frozen' (görüntü donmuş olabilir)
# OUTBOX_AGE_WARN_SEC=300 # en eski bekleyen olay bu kadar eskiyse uyarı (hiçbir şey silinmez)
# OUTBOX_MIN_FREE_BYTES=1073741824   # outbox diskinde bundan az boş alan: uyarı
# OUTBOX_WAL_LIMIT_BYTES=67108864    # checkpoint sonrası WAL dosyası bu boyuta kırpılır
# Ultralytics anonim kullanım analitiği ve çevrimiçi otomatik paket kurulumu varsayılan KAPALI (YOLO_OFFLINE=1).
# Açmak için (önerilmez): YOLO_OFFLINE=0

# ---- KALICI OUTBOX (FAZ 7) ----
# Olaylar önce diske yazılır; çökme/kesinti sonrası aynı kimliklerle gönderilir. docs/OUTBOX.md
# OUTBOX_ENABLED=1
# OUTBOX_DIR=outbox
# OUTBOX_MAX_BYTES=536870912
# OUTBOX_MAX_ITEMS=100000

# ---- KAMERA KİMLİĞİ (önerilen: sabit kimlik) ----
# Her kaynağın başına [kimlik] yazın: kimlik kaynak sırası değişse de aynı kalır ve geçmiş doğru kaynağa bağlanır.
#   VIDEO_SOURCES=[giris]Giriş kapısı=rtsp://kullanici:sifre@10.0.0.5/stream,[kule]videos/kule.mp4
# Kimlik: harf, rakam, _ ve - (en fazla 40). Parola kimliğe/etikete girmez.
# Öneksiz kaynaklar için: CAMERA_ID_MODE=source (kimlik dosya adından / webcam no'dan / maskeli URL özetinden
# türetilir) veya varsayılan index (eski davranış: cam1, cam2... sıraya bağlı, açılışta UYARI verir).
# CAMERA_ID_MODE=index

# ---- KAYNAKLAR (hepsi isteğe bağlı; yazdıkların birlikte çalışır) ----
# YouTube canlı yayınları: her satıra bir tane. İsim vermek için isim=adres
# (yt-dlp gerekir: pip install yt-dlp)
YOUTUBE_1=[canli1]Canlı_1=https://www.youtube.com/watch?v=8ObsKcpVKLs
YOUTUBE_2=[canli2]Canlı_2=https://www.youtube.com/watch?v=0imghdHjEks

# Diğer kaynaklar (dosya, rtsp, webcam) virgülle:
VIDEO_SOURCES=/Users/d2-16/Desktop/ppe-split/detector/videos/42923-434300950.mp4,/Users/d2-16/Desktop/ppe-split/detector/videos/test_video.mp4,/Users/d2-16/Desktop/ppe-split/detector/videos/video.mp4,/Users/d2-16/Desktop/ppe-split/detector/videos/Vodafone Arena İnşaatı 01.02.2015.mp4
# (Hiçbiri yazılmazsa videos/ klasöründeki tüm videolar işlenir)

# Mac (Apple Silicon): mps | NVIDIA: 0 | boş bırakırsan otomatik seçilir
DEVICE=mps
# Çok kamerada hız için düşük tut
IMGSZ=640
LOOP=1
VID_STRIDE=2
STREAM_WIDTH=640
# YouTube çözünürlük sınırı (isteğe bağlı)
# YT_FORMAT=best[height<=480]/best