# Docker Compose ayarları. Bu dosyayı ".env" adıyla kopyalayın ve parolayı değiştirin:
#   Copy-Item .env.example .env
# .env Git'e eklenmez (.gitignore). Gerçek parolaları bu örnek dosyaya yazmayın.

POSTGRES_DB=ppe
POSTGRES_USER=ppe
# Güçlü ve URL-güvenli bir parola kullanın (yalnızca harf, rakam, - ve _). Üretmek için:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=BURAYA_GUCLU_PAROLA

# Rol ayrımı (önerilen): POSTGRES_USER yalnızca yönetim içindir; migration'lar ppe_migrator (tablo sahibi),
# dashboard ppe_app (SELECT/INSERT/UPDATE; DELETE/DDL yok) ile çalışır. Roller "db-roles" servisiyle kurulur.
# İki parolayı da üretin (her biri farklı):  python -c "import secrets; print(secrets.token_urlsafe(32))"
PPE_APP_PASSWORD=BURAYA_UYGULAMA_PAROLASI
PPE_MIGRATOR_PASSWORD=BURAYA_MIGRATION_PAROLASI

# Dashboard bu adresi kullanır (psycopg 3 sürücüsü). "db" compose içindeki servis adıdır.
DATABASE_URL=postgresql+psycopg://ppe_app:${PPE_APP_PASSWORD}@db:5432/${POSTGRES_DB}
# Migration bu adresi kullanır. Tanımlı değilse DATABASE_URL kullanılır.
MIGRATE_DATABASE_URL=postgresql+psycopg://ppe_migrator:${PPE_MIGRATOR_PASSWORD}@db:5432/${POSTGRES_DB}
# Eski tek-rol kurulumu (önerilmez): iki PPE_*_PASSWORD'ü boş bırakıp
#   DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Dedektör kimlik doğrulaması. Detector/.env'deki INGEST_TOKEN ile AYNI olmalı (ikisini birlikte değiştirin;
# yalnızca birini değiştirmek dedektörün olaylarını 401 ile düşürmesine yol açar). Üretmek için:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Boş = kimlik doğrulaması kapalı (yalnızca 127.0.0.1'e bağlı ve tek kullanıcılı makinede kabul edilebilir).
INGEST_TOKEN=

# Dashboard varsayılan olarak yalnızca bu bilgisayardan erişilir. LAN'a açmak için 0.0.0.0 yapın (önerilmez).
# DASHBOARD_BIND=127.0.0.1
